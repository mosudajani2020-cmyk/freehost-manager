APP_NAME="FreeHost Manager"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/freehost-manager/public
APP_DOMAIN=freehost.example
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_PHP_SCRIPTS_GENERATE_KEY

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=freehost_manager
DB_USERNAME=freehost_app
DB_PASSWORD=change_me

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_SECURE=false
SESSION_SAMESITE=Lax
SESSION_COOKIE_NAME=FHSESSID

# Mail - log driver for development (writes to storage/logs/mail.log)
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@freehost.example
MAIL_FROM_NAME="FreeHost Manager"

# Upload
UPLOAD_MAX_MB=20

# Password policy
PASSWORD_MIN_LENGTH=8

# Features
REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=false
DEFAULT_PLAN_SLUG=free
MAINTENANCE_MODE=false

# Providers (P1) — local_mock for local development. No credentials required.
# Set to a real provider implementation in production.
PROVISIONING_PROVIDER=local_mock
DNS_PROVIDER=local_mock
SSL_PROVIDER=local_mock
BACKUP_PROVIDER=local_mock
PAYMENT_PROVIDER=local_mock
USAGE_PROVIDER=local_mock
MONITORING_PROVIDER=local_mock
DOMAIN_PROVIDER=local_mock

# Worker (P1) — queue poller settings. Worker-specific overrides may be placed
# in .env.worker (see .env.worker.example); it is never loaded by the web app.
WORKER_POLL_INTERVAL=2
WORKER_LEASE_SECONDS=120
WORKER_BACKOFF_BASE_SECONDS=5
WORKER_BACKOFF_MAX_SECONDS=300
# WORKER_LOG_FILE=/var/log/freehost/worker.log
# WORKER_STOP_FILE=/run/freehost-worker.stop
