# Worker-only environment example (P1).
#
# Copy to .env.worker next to .env and adjust when the provisioning worker needs
# values DIFFERENT from the control panel. The worker loads the web .env first,
# then this MUTABLE overlay on top. The web application NEVER loads this file.
#
# .gitignore keeps .env.worker private; only this .example is committed.
#
# All values are optional — the worker falls back to the web .env, then to
# config/worker.php defaults.

# Provider selection still comes from the web .env (shared with the control
# panel) unless overridden here:
# PROVISIONING_PROVIDER=local_mock

# Polling and leases
WORKER_POLL_INTERVAL=2
WORKER_LEASE_SECONDS=120

# Bounded retry backoff (seconds)
WORKER_BACKOFF_BASE_SECONDS=5
WORKER_BACKOFF_MAX_SECONDS=300

# Logging (defaults to storage/logs/worker.log)
# WORKER_LOG_FILE=

# Graceful shutdown via stop-file (works on any OS incl. Windows):
# create this file and the worker stops after the current job.
# WORKER_STOP_FILE=

# NOTE: never put real credentials here. The worker never inspects .env — it
# loads the same .env as the web app plus this overlay. Real infrastructure
# credentials belong in the control-panel environment only.

# Node API worker secret is stored encrypted in hosting_nodes.api_secret_encrypted,
# not as plaintext in .env. The worker decrypts via APP_KEY at runtime.
# For local mock testing, no plaintext secret is required.
# NODE_API_TLS_VERIFY=true  # for staging/production worker