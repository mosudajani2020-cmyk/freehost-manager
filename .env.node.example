# Node-only environment example (P3).
# The hosting node itself stores its API secret independently from the control panel.
# In production this file / environment is on the hosting node, not on the control panel.
# The control panel stores only api_secret_encrypted (via NodeCredentialManager).
# Never commit real secrets.

NODE_API_SECRET=CHANGE_ME_GENERATE_WITH_PHP_SCRIPTS_GENERATE_KEY
NODE_API_TLS_VERIFY=true
APP_ENV=production
